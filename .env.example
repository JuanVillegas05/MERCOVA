# ADVERTENCIA: APP_ENV=local y APP_DEBUG=true son solo para desarrollo local.
# En producción, APP_ENV debe ser "production" y APP_DEBUG debe ser "false":
# con APP_DEBUG=true, cualquier error 500 de la API devuelve el stack trace
# completo (rutas de archivos, código, variables) como JSON a quien sea.
APP_NAME=Mercova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo transaccional. En local "log" escribe los correos en
# storage/logs/laravel.log. Para enviarlos de verdad con Brevo (SMTP):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<login SMTP de Brevo, p. ej. xxxx@smtp-brevo.com>
#   MAIL_PASSWORD=<clave SMTP de Brevo, NO la contraseña de la cuenta>
#   MAIL_FROM_ADDRESS=<remitente verificado en Brevo>
# O con la API HTTP de Brevo (obligatorio en Render, que bloquea SMTP):
#   MAIL_MAILER=brevo
#   BREVO_API_KEY=<API key de Brevo, empieza por xkeysib->
# Los correos se encolan: con QUEUE_CONNECTION=database necesitan un worker
# (php artisan queue:work); con QUEUE_CONNECTION=sync salen al instante.
BREVO_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notificaciones@mercova.test"
MAIL_FROM_NAME="${APP_NAME}"

# API key de https://resend.com. Con MAIL_MAILER=resend y esta llave, los
# correos de bienvenida y recuperación de contraseña se envían de verdad.
RESEND_API_KEY=

# Imágenes de productos y servicios en Cloudinary (Dashboard → "API
# environment variable"). Sin esto se guardan en storage/ local, que solo se
# ve desde este computador; en producción es obligatorio.
CLOUDINARY_URL=

# Correos que se vuelven administrador automáticamente al registrarse o
# iniciar sesión (separados por coma, sin espacios extra).
MERCOVA_ADMIN_EMAILS=

# Pasarela de pagos (Wompi) — https://comercios.wompi.co > Desarrolladores
# Llaves de prueba: pub_test_/prv_test_; de producción: pub_prod_/prv_prod_.
# El secreto de integridad (test_integrity_...) firma los enlaces de pago y
# el de eventos (test_events_...) valida el webhook. En el panel, configura
# la "URL de eventos" como {APP_URL}/api/webhooks/wompi.
# Sin llave pública + secreto de integridad el checkout sigue funcionando,
# solo que los pedidos quedan en "pending" sin que se cobre nada de verdad.
# La llave privada y los secretos NUNCA van al frontend: solo la pública.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Login con Google/Apple (Socialite). GOOGLE_CLIENT_ID/SECRET salen de
# https://console.cloud.google.com (Credenciales > ID de cliente OAuth,
# tipo "Aplicación web", con el redirect URI de abajo agregado tal cual).
# APPLE_CLIENT_SECRET no es un texto fijo: es un JWT firmado con la llave
# .p8 de Apple Developer (Certificates, Identifiers & Profiles > Keys),
# válido máximo 6 meses — hay que regenerarlo antes de que expire.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# Opcional: si el frontend aparte del equipo también quiere iniciar el login
# social (en vez de usar las páginas de login/registro de este backend), esta
# es la única URL a la que se le permite devolver el token por
# ?redirect_uri= (cualquier otro dominio se ignora por seguridad).
MERCOVA_FRONTEND_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
